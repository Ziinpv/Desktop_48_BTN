{
  "name": "luxe-wedding-studio",
  "version": "1.0.0",
  "description": "LUXE WEDDING STUDIO - Hệ thống quản lý studio ảnh cưới (Nhóm 24)",
  "author": "Hoàng Long - Nhóm 24",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 http-get://127.0.0.1:8000/api/health && cross-env VITE_DEV_SERVER=http://127.0.0.1:5173 electron .",
    "dev:backend": ".venv\\Scripts\\python.exe -m uvicorn backend.app:app --reload --host 127.0.0.1 --port 8000",
    "backend": ".venv\\Scripts\\python.exe -m uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win nsis",
    "dist:mac": "vite build && electron-builder --mac dmg",
    "dist:linux": "vite build && electron-builder --linux AppImage",
    "test:backend": ".venv\\Scripts\\python.exe -m pytest tests -q",
    "seed": ".venv\\Scripts\\python.exe -m backend.seed"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@reduxjs/toolkit": "^2.5.0",
    "antd": "^5.22.6",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "i18next": "^24.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
